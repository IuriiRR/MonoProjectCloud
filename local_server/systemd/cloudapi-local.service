[Unit]
Description=CloudApi local admin server (FastAPI/uvicorn on port 8088)
After=network-online.target cloudapi-services.target
Wants=network-online.target cloudapi-services.target

[Service]
Type=simple
# Matched to README: user ironcow, repo at ~/Projects/MonoProjectCloud. Edit if yours differs.
User=ironcow
Group=ironcow
WorkingDirectory=/home/ironcow/Projects/MonoProjectCloud
EnvironmentFile=/etc/cloudapi/local_server.env
Environment=PYTHONPATH=/home/ironcow/Projects/MonoProjectCloud:/home/ironcow/Projects/MonoProjectCloud/local_server/src
ExecStart=/home/ironcow/Projects/MonoProjectCloud/.venv/bin/uvicorn local_server.main:app --host 127.0.0.1 --port 8088
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# ProtectHome=true would block reading the app tree under /home; leave off for typical pyenv layout.

[Install]
WantedBy=multi-user.target
