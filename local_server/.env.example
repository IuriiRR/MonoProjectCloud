# Firestore mode: true = local emulator (default), false = GCP Cloud Firestore
LOCAL_DB=true

GOOGLE_APPLICATION_CREDENTIALS=/etc/cloudapi/sa.json
GCP_PROJECT_ID=cloud-monohelper
GCP_SCHEDULER_REGION=europe-west1

CLOUD_UNBLOCKER_JOB=rpi-unblocker
CLOUD_SYNC_WORKER_JOB=sync-worker-hourly
CLOUD_DAILY_REPORTS_JOB=daily-reports-daily

# GCP Cloud Function URLs (production) or local emulator ports (dev).
# The monolith calls these APIs to fetch users, update accounts, and store transactions.
USERS_API_URL=http://127.0.0.1:8081
ACCOUNTS_API_URL=http://127.0.0.1:8082
TRANSACTIONS_API_URL=http://127.0.0.1:8083
# Monolith self-URL: background transaction sync threads loop back to /sync/transactions.
SYNC_TRANSACTIONS_URL=http://127.0.0.1:8088
REPORT_API_URL=http://127.0.0.1:8086

INTERNAL_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_URL is only required for failover (the cloud unblocker
# re-points Telegram back to the deployed cloud telegram_bot function when
# the Pi stops heart-beating). Optional otherwise.
TELEGRAM_WEBHOOK_URL=https://telegram-bot-xxxx.a.run.app
TELEGRAM_WEBHOOK_SECRET=

REPORT_TIMEZONE=Europe/Kyiv
SYNC_WORKER_CRON=0 18 * * *
DAILY_REPORTS_CRON=45 21 * * *

# FastAPI monolith: admin panel, healthz, SQLite storage, scheduler (replaces cloudapi-local.service)
FASTAPI_URL=http://127.0.0.1:8088

HEARTBEAT_INTERVAL_SEC=600
UNBLOCKER_LEAD_SEC=1800

# Optional Gemini key for report_api LLM generation (lazy-loaded).
GEMINI_API_KEY=

SENTRY_DSN=
DISABLE_SENTRY=1
